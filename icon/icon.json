{
  "format": 1,
  "id": "clock",
  "name": "Clock",
  "kind": "app",
  "keyline": "full",
  "layers": [
    {
      "role": "background",
      "file": "background.svg"
    },
    {
      "role": "foreground",
      "file": "foreground.svg",
      "shadow": "neutral"
    }
  ],
  "variants": {
    "dark": {
      "background": "background-dark.svg",
      "foreground": "foreground-dark.svg",
      "hand-hour": "hand-hour-dark.svg",
      "hand-minute": "hand-minute-dark.svg",
      "hand-second": "hand-second-dark.svg",
      "cap": "cap-dark.svg"
    }
  },
  "dynamic": {
    "type": "clock",
    "hands": [
      {
        "unit": "hour",
        "file": "hand-hour.svg"
      },
      {
        "unit": "minute",
        "file": "hand-minute.svg"
      },
      {
        "unit": "second",
        "file": "hand-second.svg",
        "min_size": 64
      }
    ],
    "cap": "cap.svg",
    "pivot": [
      512,
      512
    ]
  },
  "rendered": {
    "default": "icon.png",
    "dark": "icon-dark.png",
    "clear": "icon-clear.png",
    "clear-dark": "icon-clear-dark.png",
    "tinted": "icon-tinted.png",
    "tinted-dark": "icon-tinted-dark.png"
  }
}
